  "grammar_topics": [
    {
      "content_id": "grammar-heissen-present",
      "name": "Present tense of heißen (ich heiße)",
      "explanation": "Use ich heiße to say your name in a simple introduction.",
      "cefr_level": "A1",
      "example_data": {
        "german": "Ich heiße Anna.",
        "english": "My name is Anna."
      },
      "approved": true
    },
    {
      "content_id": "grammar-german-special-letters",
      "name": "German special letters: ä, ö, ü, ß",
      "explanation": "German uses ä, ö, ü, and ß in spelling. Keep these characters when you type German words unless an exercise explicitly accepts another spelling.",
      "cefr_level": "A1",
      "example_data": {
        "examples": ["Straße", "schön", "München"],
        "focus": "spelling and pronunciation"
      },
      "review_status": "pending_human_review",
      "approved": false
    },
    {
      "content_id": "grammar-sein-present-introduction",
      "name": "Present tense of sein for introductions",
      "explanation": "Use bin with ich and bist with du to say who someone is or how someone feels.",
      "cefr_level": "A1",
      "example_data": {
        "german": "Ich bin Mara. Du bist freundlich.",
        "english": "I am Mara. You are friendly."
      },
      "review_status": "pending_human_review",
      "approved": false
    },
    {
      "content_id": "grammar-regular-verbs-ich-du",
      "name": "Regular present-tense verbs: ich and du",
      "explanation": "Many German verbs use -e with ich and -st with du in the present tense, for example ich wohne and du wohnst.",
      "cefr_level": "A1",
      "example_data": {
        "german": "Ich komme aus Kanada. Wo wohnst du?",
        "english": "I come from Canada. Where do you live?"
      },
      "review_status": "pending_human_review",
      "approved": false
    },
    {
      "content_id": "grammar-age-sein-jahre-alt",
      "name": "Saying your age with sein and Jahre alt",
      "explanation": "Say your age with sein plus a number and Jahre alt: Ich bin 22 Jahre alt.",
      "cefr_level": "A1",
      "example_data": {
        "german": "Wie alt bist du? Ich bin 22 Jahre alt.",
        "english": "How old are you? I am 22 years old."
      },
      "review_status": "pending_human_review",
      "approved": false
    },
    {
      "content_id": "grammar-w-questions",
      "name": "Basic W-questions",
      "explanation": "Start simple information questions with words such as wie, wer, wo, and woher. The verb follows the question word.",
      "cefr_level": "A1",
      "example_data": {
        "german": "Wie heißt du? Woher kommst du?",
        "english": "What is your name? Where do you come from?"
      },
      "review_status": "pending_human_review",
      "approved": false
    }
  ],
